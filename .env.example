# Copy to .env and fill in. The template runs with ALL of these empty
# (in-memory data + a dev auth secret). Set them for real persistence.

# Postgres connection string. Empty -> demo uses an in-memory store.
DATABASE_URL=

# Auth signing secret. Empty -> a dev-only fallback is used (NOT for production).
# Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app (used by auth + absolute links).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
